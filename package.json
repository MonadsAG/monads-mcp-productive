{
  "name": "@monadsag/productive-mcp",
  "version": "1.2.0",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "productive-mcp": "./build/index.js"
  },
  "files": [
    "build/**/*.js",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:types": "wrangler types",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "package:smoke": "tsx scripts/smoke-package.ts",
    "spec:sync": "tsx scripts/sync-spec.ts",
    "spec:impact": "tsx scripts/analyze-impact.ts",
    "spec:changelog": "tsx scripts/fetch-changelog.ts",
    "spec:guides": "tsx scripts/sync-guides.ts"
  },
  "keywords": [
    "mcp",
    "productive",
    "productive.io",
    "api",
    "claude",
    "model-context-protocol",
    "ai",
    "project-management"
  ],
  "author": "jayat3dn",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MonadsAG/monads-mcp-productive.git"
  },
  "bugs": {
    "url": "https://github.com/MonadsAG/monads-mcp-productive/issues"
  },
  "homepage": "https://github.com/MonadsAG/monads-mcp-productive#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "description": "MCP server for Productive.io API integration",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.2",
    "dotenv": "^16.6.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@cloudflare/workers-oauth-provider": "^0.4.0",
    "@cloudflare/workers-types": "^4.20260402.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.4",
    "agents": "^0.9.0",
    "hono": "^4.12.9",
    "js-yaml": "^5.3.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.79.0"
  }
}

# Local Worker + test credentials. Copy to `.dev.vars` and fill in.
#
#   cp .dev.vars.example .dev.vars
#
# `.dev.vars` is gitignored; this template is not. It is read by `wrangler dev`
# and by tests/setup.ts. Without it the five suites under tests/integration/
# skip themselves and `npm test` passes without touching Productive at all.
#
# WARNING: the integration suites WRITE to whichever organization these
# credentials point at -- they create deals, budgets and folders and clean them
# up in afterAll. Point this at a sandbox org, never at production.

# --- Productive ---------------------------------------------------------------

# Personal access token for the target org. Required for the integration suites;
# unset means they skip.
PRODUCTIVE_API_TOKEN=

# Organization ID *including* the slug (e.g. 12345-company-name, not just
# 12345) -- the short form breaks invoice PDF URL generation.
PRODUCTIVE_ORG_ID=

# Defaults to production when unset. For local work and the integration suites
# use the sandbox:
#   https://api-sandbox.productive.io/api/v2/
# The trailing slash matters: makeRequest() concatenates without a separator.
PRODUCTIVE_API_BASE_URL=https://api-sandbox.productive.io/api/v2/

# Person ID used by the stdio "my tasks" path. Optional.
PRODUCTIVE_USER_ID=

# Optional, comma-separated: restrict which toolsets this deployment exposes
# (core, tasks, custom_fields, comments, time_tracking, invoicing, docs, todos).
# Unset means all of them.
# PRODUCTIVE_TOOLSETS=

# --- Microsoft Entra ID (Worker OAuth) ----------------------------------------

# From the App Registration. Its redirect URIs must include BOTH /callback and
# /settings/callback.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=

# --- Crypto -------------------------------------------------------------------

# Random hex key for HMAC cookie signing: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY=

# 32-byte hex key for AES-256-GCM encryption of per-user PATs: openssl rand -hex 32
PAT_ENC_KEY=
